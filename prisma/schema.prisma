generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Syllabus {
  id     String  @id @default(cuid())
  slug   String  @unique
  name   String
  grades Grade[]
}

model Grade {
  id         String    @id @default(cuid())
  slug       String
  name       String
  order      Int       @default(0)
  syllabusId String
  syllabus   Syllabus  @relation(fields: [syllabusId], references: [id], onDelete: Cascade)
  subjects   Subject[]

  @@unique([syllabusId, slug])
}

model Subject {
  id      String  @id @default(cuid())
  slug    String
  name    String
  gradeId String
  grade   Grade   @relation(fields: [gradeId], references: [id], onDelete: Cascade)
  topics  Topic[]

  @@unique([gradeId, slug])
}

model Topic {
  id               String   @id @default(cuid())
  slug             String   @unique
  name             String
  description      String?
  order            Int      @default(0)
  difficulty       String?
  estimatedHours   Int?
  prerequisites    String[]
  learningOutcomes String[]

  subjectId String
  subject   Subject @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  materials Material[]
  videos    Video[]
  tutors    Tutor[]   @relation("TopicTutors")

  relatedTo Topic[] @relation("RelatedTopics")
  relatedBy Topic[] @relation("RelatedTopics")
}

model Material {
  id      String @id @default(cuid())
  title   String
  url     String
  topicId String
  topic   Topic  @relation(fields: [topicId], references: [id], onDelete: Cascade)
}

model Video {
  id          String   @id @default(cuid())
  youtubeId   String
  title       String
  description String?
  duration    String?
  topicId     String
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  tutorId     String
  tutor       Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  visitors    Student[] @relation("StudentVisitedVideos")
}

model Tutor {
  id                String   @id @default(cuid())
  slug              String   @unique
  name              String
  subject           String
  tutorType         String
  image             String?
  rating            Float    @default(0)
  reviewsCount      Int      @default(0)
  experience        String?
  lessonsCount      Int      @default(0)
  studentsCount     Int      @default(0)
  university        String?
  languages         String[]
  syllabuses        String[] @default([])
  price             String?
  onlineAvailable   Boolean  @default(false)
  physicalAvailable Boolean  @default(false)
  email             String   @unique
  phone             String?
  location          String?
  qualifications    String[]
  specializations   String[]
  teachingStyle     String?
  bio               String?
  createdAt         DateTime @default(now())

  reviews         Review[]
  videos          Video[]
  topics          Topic[]              @relation("TopicTutors")
  followers       Student[]            @relation("StudentFollowedTutors")
  ads             TutorAd[]
  contactRequests TutorContactRequest[]
}

model TutorAd {
  id        String   @id @default(cuid())
  tutorId   String
  tutor     Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  title     String
  tagline   String?
  imageUrl  String?
  ctaText   String   @default("View Tutor Profile")
  badge     String   @default("PAID AD")
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}


model TutorContactRequest {
  id           String   @id @default(cuid())
  tutorId      String
  tutor        Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  studentName  String
  studentEmail String?
  whatsapp     String?
  phone        String?
  syllabusName String?
  gradeName    String?
  subjectName  String?
  message      String?
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())
}

model Review {
  id      String   @id @default(cuid())
  student String
  rating  Int
  comment String?
  date    DateTime
  tutorId String
  tutor   Tutor    @relation(fields: [tutorId], references: [id], onDelete: Cascade)
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model TutorApplication {
  id                String   @id @default(cuid())
  name              String
  email             String
  phone             String?
  university        String?
  tutorType         String?  @default("Private Tutor")
  subjects          String
  syllabuses        String
  mediums           String   @default("English, Sinhala")
  location          String?
  onlineAvailable   Boolean  @default(true)
  physicalAvailable Boolean  @default(false)
  experience        String?
  bio               String
  status            String   @default("pending") // pending | approved | rejected
  createdAt         DateTime @default(now())
}

model Student {
  id             String   @id @default(cuid())
  email          String   @unique
  name           String?
  createdAt      DateTime @default(now())
  followedTutors Tutor[]  @relation("StudentFollowedTutors")
  visitedVideos  Video[]  @relation("StudentVisitedVideos")
}